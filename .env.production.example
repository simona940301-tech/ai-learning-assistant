# ============================================
# Feature Flags
# ============================================

# Detective Mode (偵探檔案：真相拼圖)
# Status: Incomplete - uses mock data, API not implemented
# Set to 'true' to enable in production
NEXT_PUBLIC_ENABLE_DETECTIVE=false

# Editor Mode (實習編輯)
# Status: Incomplete - needs production testing
# Set to 'true' to enable in production
NEXT_PUBLIC_ENABLE_EDITOR=false

# Focus Mode (專注修煉)
# Status: Production-ready
# Set to 'false' to disable
NEXT_PUBLIC_ENABLE_FOCUS=true

# Practice Mode (無限練習)
# Status: Production-ready
# Set to 'false' to disable
NEXT_PUBLIC_ENABLE_PRACTICE=true

# UGC Mode (內容貢獻)
# Status: Production-ready
# Set to 'false' to disable
NEXT_PUBLIC_ENABLE_UGC=true

# System Battle (系統對戰)
# Status: Production-ready
# Set to 'false' to disable
NEXT_PUBLIC_ENABLE_SYSTEM_BATTLE=true

# Custom Battle (自訂對戰)
# Status: Production-ready
# Set to 'false' to disable
NEXT_PUBLIC_ENABLE_CUSTOM_BATTLE=true

# ============================================
# Other Feature Flags
# ============================================

# Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Debug Logs
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# ============================================
# Supabase Configuration
# ============================================

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# App Configuration
# ============================================

NEXT_PUBLIC_TIMEZONE=Asia/Taipei
NEXT_PUBLIC_APP_REGION=tw
