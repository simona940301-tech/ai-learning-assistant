# ============================================
# Production Environment Variables
# ============================================
# This file documents all environment variables needed for production deployment.
# Copy these to Vercel Dashboard > Settings > Environment Variables
#
# Usage:
# 1. Add each variable to Vercel with appropriate values
# 2. Select "Production" environment
# 3. Redeploy to apply changes
#
# ============================================

# --------------------------------------------
# Feature Flags (Game Modes)
# --------------------------------------------
# Control which game modes are visible in production
# Default: Production-ready features enabled, incomplete features disabled

# ✅ Production-ready features (enabled by default, can override)
NEXT_PUBLIC_ENABLE_SYSTEM_BATTLE=true
NEXT_PUBLIC_ENABLE_CUSTOM_BATTLE=true
NEXT_PUBLIC_ENABLE_UGC=true
NEXT_PUBLIC_ENABLE_PRACTICE=true
NEXT_PUBLIC_ENABLE_FOCUS=true

# ❌ Incomplete features (disabled by default, enable when ready)
NEXT_PUBLIC_ENABLE_DETECTIVE=false  # Detective Mode - UI complete, API incomplete
NEXT_PUBLIC_ENABLE_EDITOR=false     # Editor Mode - Functional but needs production testing

# --------------------------------------------
# Authentication & Database
# --------------------------------------------
# Supabase configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mock user (disable in production)
NEXT_PUBLIC_DISABLE_MOCK_USER=true
NEXT_PUBLIC_ENABLE_REAL_AUTH_TEST=true

# --------------------------------------------
# WebSocket Server (Battle System)
# --------------------------------------------
# Production WebSocket server URL
NEXT_PUBLIC_WS_URL=wss://your-battle-ws.fly.dev/ws/battle
NEXT_PUBLIC_BATTLE_WS_ENABLED=true

# Internal API key for server-to-server communication
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your-secure-random-key-here

# --------------------------------------------
# AI Services
# --------------------------------------------
# Gemini API keys for AI features
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AVATAR_API_KEY=your-gemini-avatar-api-key

# --------------------------------------------
# Redis (Caching & Session)
# --------------------------------------------
# Upstash Redis for edge caching
REDIS_ENABLED=true
REDIS_URL=redis://default:your-password@your-redis.upstash.io:6379

# --------------------------------------------
# Feature Flags (Legacy Hotfixes)
# --------------------------------------------
# These are for backward compatibility, keep enabled
NEXT_PUBLIC_HOTFIX_BATCH1=true
NEXT_PUBLIC_HOTFIX_QR_ONE_STEP=true
NEXT_PUBLIC_HOTFIX_MICRO_CARD=true
NEXT_PUBLIC_HOTFIX_SAVED_BADGE=true
NEXT_PUBLIC_HOTFIX_CTA_TEXT=true
NEXT_PUBLIC_HOTFIX_BATCH1_5=true
NEXT_PUBLIC_HOTFIX_BATCH1_5_SINGLE_CTA=true
NEXT_PUBLIC_HOTFIX_BATCH1_5_NEAR_DIFFICULTY=true
NEXT_PUBLIC_HOTFIX_BATCH1_5_BATCH_API=true
NEXT_PUBLIC_HOTFIX_BATCH1_5_SAMPLER_PERF=true

# --------------------------------------------
# Optional Features
# --------------------------------------------
# Chick companion hatching feature
FEATURE_CHICK_HATCHING_ENABLED=true

# Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Debug Logs
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# App Configuration
NEXT_PUBLIC_TIMEZONE=Asia/Taipei
NEXT_PUBLIC_APP_REGION=tw

# --------------------------------------------
# PWA Configuration
# --------------------------------------------
# PWA is automatically enabled in production builds
# No environment variables needed - configured in next.config.js
