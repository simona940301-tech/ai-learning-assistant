# ============================================
# Supabase Configuration (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for Preview/Dev mode mock user
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Service-to-Service API Keys (Required for Production)
# ============================================
# Generate secure random keys: openssl rand -hex 32

# For Rust battle-ws service to call /api/play/battle/events
BATTLE_EVENTS_API_KEY=your-battle-events-api-key-here

# For internal services to call /api/internal/* routes
INTERNAL_API_KEY=your-internal-api-key-here

# ============================================
# Preview/Development Mode Authentication
# ============================================
# Enable mock user for local development (auto-enabled when NODE_ENV=development)
# For Vercel Preview deployments, set these in Vercel environment variables:
# - NEXT_PUBLIC_PREVIEW_FORCE_MOCK=true (client-side)
# - PREVIEW_FORCE_MOCK=true (server-side)

# Uncomment for local testing of preview mode behavior:
# NEXT_PUBLIC_PREVIEW_FORCE_MOCK=true

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your-openai-api-key

# ============================================
# Battle System (Play Page)
# ============================================
# WebSocket URL for battle system
NEXT_PUBLIC_BATTLE_WS_URL=ws://localhost:8080/ws/battle

# ============================================
# PassageDock Feature Flags
# ============================================
# Enable unified long-form question viewer with evidence highlighting

# Enable for Reading Comprehension (E4)
NEXT_PUBLIC_ENABLE_PASSAGE_DOCK=true

# Enable for Cloze/Fill-in-Blank (E2/E3)
NEXT_PUBLIC_ENABLE_PASSAGE_DOCK_CLOZE=true

# ============================================
# Optional Features
# ============================================
# Hide development banner in production
# NEXT_PUBLIC_HIDE_DEV_BANNER=true

# Telemetry (optional)
# NEXT_PUBLIC_ENABLE_TELEMETRY=true
