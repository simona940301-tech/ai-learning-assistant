'use client'

import { useEffect, useState } from 'react'
import { motion } from 'framer-motion'
import { FileText, Sparkles, Brain, Target, Loader2, BookOpen } from 'lucide-react'
import ReactMarkdown from 'react-markdown'
import remarkGfm from 'remark-gfm'
import { FileAnalysis } from '@/lib/types'
import NotebookSaveButton from './NotebookSaveButton'

interface ProgressiveAnalysisCardProps {
    analysisId: string
    fileName: string
    onAnalysisUpdate?: (analysis: FileAnalysis) => void
}

interface ProgressStage {
    id: string
    name: string
    icon: React.ReactNode
    targetTime: string
    status: 'pending' | 'current' | 'done' | 'failed'
}

// ============================================
// Progress Indicator Component
// ============================================

function ProgressIndicator({ stages }: { stages: ProgressStage[] }) {
    return (
        <div className="w-full overflow-x-auto">
            <div className="flex items-center gap-2 px-4 py-3 rounded-2xl border border-border bg-card min-w-[600px] md:min-w-0">
                {stages.map((stage, index) => (
                    <div key={stage.id} className="flex items-center gap-1 sm:gap-2 flex-1 min-w-0">
                        stage.status === 'done' && "bg-green-500/10 border border-green-500/30",
                        stage.status === 'failed' && "bg-red-500/10 border border-red-500/30",
                        stage.status === 'pending' && "bg-secondary/10 border border-border"
                        )}>
                        <div className={cn(
                            "shrink-0 w-6 h-6 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center transition-colors",
                            stage.status === 'current' && "bg-blue-500/20 text-blue-600",
                            stage.status === 'done' && "bg-green-500/20 text-green-600",
                            stage.status === 'failed' && "bg-red-500/20 text-red-600",
                            stage.status === 'pending' && "bg-secondary/20 text-muted-foreground"
                        )}>
                            {stage.status === 'done' ? (
                                <CheckCircle2 className="w-4 h-4 sm:w-5 sm:h-5" />
                            ) : stage.status === 'failed' ? (
                                <AlertCircle className="w-4 h-4 sm:w-5 sm:h-5" />
                            ) : stage.status === 'current' ? (
                                <Loader2 className="w-4 h-4 sm:w-5 sm:h-5 animate-spin" />
                            ) : (
                                <div className="w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center">
                                    {stage.icon}
                                </div>
                            )}
                        </div>

                        <div className="flex-1 min-w-0">
                            <p className={cn(
                                "text-xs sm:text-sm font-medium truncate transition-colors",
                                stage.status === 'done' && "text-green-700",
                                stage.status === 'current' && "text-blue-700",
                                stage.status === 'failed' && "text-red-700",
                                stage.status === 'pending' && "text-muted-foreground"
                            )}>
                                {stage.name}
                            </p>
                            <p className="text-[10px] sm:text-xs text-muted-foreground/60 truncate">{stage.targetTime}</p>
                        </div>
                    </div>

                        {
                        index<stages.length - 1 && (
                            <div className={cn(
                                "h-px w-2 sm:w-4 shrink-0 transition-colors",
                                stage.status === 'done' ? "bg-green-500/30" : "bg-border"
                            )} />
                        )
                    }
                    </div>
                ))}
        </div>
        </div >
    )
}

// ============================================
// Quick Preview Card (Layer 1)
// ============================================

function QuickPreviewCard({
    summary,
    subject,
    topics
}: {
    summary: string
    subject: string
    topics: string[]
}) {
    const subjectLabels: Record<string, string> = {
        chinese: '國文',
        english: '英文',
        math: '數學',
        science: '自然',
        social: '社會',
        other: '其他'
    }

    return (
        <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="rounded-2xl border border-blue-500/20 bg-blue-50/50 p-6 space-y-4"
        >
            <div className="flex items-center gap-2">
                <Sparkles className="w-5 h-5 text-blue-500" />
                <h3 className="text-lg font-semibold text-blue-700">快速預覽</h3>
                <span className="ml-auto text-xs text-blue-600/60">3 秒分析</span>
            </div>

            <p className="text-foreground/90 leading-relaxed">{summary}</p>

            <div className="flex items-center gap-3 pt-2 border-t border-blue-500/10">
                <span className="px-3 py-1 rounded-full bg-blue-100 border border-blue-200 text-sm text-blue-700">
                    {subjectLabels[subject] || subject}
                </span>
                {topics.map((topic, idx) => (
                    <span
                        key={idx}
                        className="px-3 py-1 rounded-full bg-white border border-border text-sm text-foreground/70"
                    >
                        {topic}
                    </span>
                ))}
            </div>
        </motion.div>
    )
}

// ============================================
// Deep Analysis Card (Layer 2)
// ============================================

function DeepAnalysisCard({
    concepts,
    insights,
    questions,
    notes
}: {
    concepts: CoreConcept[]
    insights: KeyInsight[]
    questions: SuggestedQuestion[]
    notes: string
}) {
    const [activeTab, setActiveTab] = useState<'concepts' | 'insights' | 'questions' | 'notes'>('concepts')

    return (
        <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="rounded-2xl border border-purple-500/20 bg-purple-50/50 p-6 space-y-4"
        >
            <div className="flex items-center gap-2">
                <Brain className="w-5 h-5 text-purple-500" />
                <h3 className="text-lg font-semibold text-purple-700">深度分析</h3>
                <span className="ml-auto text-xs text-purple-600/60">15 秒分析</span>
            </div>

            {/* Tabs */}
            <div className="flex gap-2 border-b border-purple-500/10 pb-2">
                {[
                    { id: 'concepts', label: '核心概念', count: concepts.length },
                    { id: 'insights', label: '關鍵洞察', count: insights.length },
                    { id: 'questions', label: '思考題', count: questions.length },
                    { id: 'notes', label: '筆記', count: null }
                ].map(tab => (
                    <button
                        key={tab.id}
                        onClick={() => setActiveTab(tab.id as any)}
                        className={cn(
                            "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                            activeTab === tab.id
                                ? "bg-purple-100 text-purple-700"
                                : "text-muted-foreground hover:text-foreground hover:bg-purple-50"
                        )}
                    >
                        {tab.label}
                        {tab.count !== null && (
                            <span className="ml-1.5 text-xs opacity-60">({tab.count})</span>
                        )}
                    </button>
                ))}
            </div>

            {/* Content */}
            <div className="min-h-[200px]">
                {activeTab === 'concepts' && (
                    <div className="space-y-4">
                        {concepts.map((concept, idx) => (
                            <div key={idx} className="p-4 rounded-xl bg-white border border-border/50 shadow-sm">
                                <div className="flex items-start justify-between mb-2">
                                    <h4 className="font-semibold text-foreground">{concept.name}</h4>
                                    <div className="flex gap-0.5">
                                        {Array.from({ length: 5 }).map((_, i) => (
                                            <div
                                                key={i}
                                                className={cn(
                                                    "w-1.5 h-1.5 rounded-full",
                                                    i < concept.importance ? "bg-yellow-400" : "bg-gray-200"
                                                )}
                                            />
                                        ))}
                                    </div>
                                </div>
                                <p className="text-sm text-muted-foreground leading-relaxed">{concept.explanation}</p>
                                {concept.pageRefs.length > 0 && (
                                    <p className="text-xs text-muted-foreground/60 mt-2">
                                        參考頁碼: {concept.pageRefs.join(', ')}
                                    </p>
                                )}
                            </div>
                        ))}
                    </div>
                )}

                {activeTab === 'insights' && (
                    <div className="space-y-4">
                        {insights.map((insight, idx) => (
                            <div key={idx} className="p-4 rounded-xl bg-white border border-border/50 shadow-sm">
                                <p className="text-foreground/90 leading-relaxed mb-2">{insight.insight}</p>
                                <p className="text-sm text-muted-foreground leading-relaxed">證據: {insight.evidence}</p>
                                {insight.pageRefs.length > 0 && (
                                    <p className="text-xs text-muted-foreground/60 mt-2">
                                        參考頁碼: {insight.pageRefs.join(', ')}
                                    </p>
                                )}
                            </div>
                        ))}
                    </div>
                )}

                {activeTab === 'questions' && (
                    <div className="space-y-3">
                        {questions.map((q, idx) => (
                            <div key={idx} className="p-4 rounded-xl bg-white border border-border/50 shadow-sm">
                                <div className="flex items-start gap-3">
                                    <span className="shrink-0 w-6 h-6 rounded-full bg-purple-100 text-purple-700 text-xs font-medium flex items-center justify-center">
                                        {idx + 1}
                                    </span>
                                    <div className="flex-1">
                                        <p className="text-foreground/90 leading-relaxed">{q.question}</p>
                                        <div className="flex items-center gap-2 mt-2">
                                            <span className="text-xs text-muted-foreground">難度 {q.difficulty}/5</span>
                                            <span className="text-xs text-muted-foreground/40">•</span>
                                            <span className="text-xs text-muted-foreground">{q.topic}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                )}

                {activeTab === 'notes' && (
                    <div className="prose prose-sm max-w-none text-foreground">
                        <div
                            className="text-foreground/80 leading-relaxed"
                            dangerouslySetInnerHTML={{ __html: notes.replace(/\n/g, '<br/>') }}
                        />
                    </div>
                )}
            </div>
        </motion.div>
    )
}

// ============================================
// Exam Prediction Card (Layer 3)
// ============================================

function ExamPredictionCard({
    predictions,
    weakPoints,
    roadmap
}: {
    predictions: ExamQuestion[]
    weakPoints: { concept: string; reason: string; practiceSuggestion: string }[]
    roadmap: { phase: string; topics: string[]; estimatedHours: number }[]
}) {
    const [activeTab, setActiveTab] = useState<'questions' | 'weakpoints' | 'roadmap'>('questions')
    const [selectedQuestion, setSelectedQuestion] = useState<number | null>(null)

    const difficultyColors = {
        1: 'text-green-600 bg-green-100 border-green-200',
        2: 'text-blue-600 bg-blue-100 border-blue-200',
        3: 'text-yellow-600 bg-yellow-100 border-yellow-200',
        4: 'text-orange-600 bg-orange-100 border-orange-200',
        5: 'text-red-600 bg-red-100 border-red-200'
    }

    return (
        <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="rounded-2xl border border-green-500/20 bg-green-50/50 p-6 space-y-4"
        >
            <div className="flex items-center gap-2">
                <Target className="w-5 h-5 text-green-500" />
                <h3 className="text-lg font-semibold text-green-700">考題預測</h3>
                <span className="ml-auto text-xs text-green-600/60">30 秒分析</span>
            </div>

            {/* Tabs */}
            <div className="flex gap-2 border-b border-green-500/10 pb-2">
                {[
                    { id: 'questions', label: '預測題目', count: predictions.length },
                    { id: 'weakpoints', label: '易錯點', count: weakPoints.length },
                    { id: 'roadmap', label: '學習路徑', count: roadmap.length }
                ].map(tab => (
                    <button
                        key={tab.id}
                        onClick={() => setActiveTab(tab.id as any)}
                        className={cn(
                            "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                            activeTab === tab.id
                                ? "bg-green-100 text-green-700"
                                : "text-muted-foreground hover:text-foreground hover:bg-green-50"
                        )}
                    >
                        {tab.label}
                        <span className="ml-1.5 text-xs opacity-60">({tab.count})</span>
                    </button>
                ))}
            </div>

            {/* Content */}
            <div className="min-h-[300px]">
                {activeTab === 'questions' && (
                    <div className="space-y-3">
                        {predictions.map((q, idx) => (
                            <div key={idx} className="rounded-xl bg-white border border-border/50 overflow-hidden shadow-sm">
                                <button
                                    onClick={() => setSelectedQuestion(selectedQuestion === idx ? null : idx)}
                                    className="w-full p-4 text-left hover:bg-gray-50 transition-colors"
                                >
                                    <div className="flex items-start gap-3">
                                        <span className="shrink-0 w-7 h-7 rounded-full bg-green-100 text-green-700 text-sm font-medium flex items-center justify-center">
                                            {idx + 1}
                                        </span>
                                        <div className="flex-1 min-w-0">
                                            <p className="text-foreground/90 leading-relaxed">{q.questionText}</p>
                                            <div className="flex items-center gap-2 mt-2 flex-wrap">
                                                <span className={cn(
                                                    "px-2 py-0.5 rounded-full text-xs border",
                                                    difficultyColors[q.difficulty as keyof typeof difficultyColors] || difficultyColors[3]
                                                )}>
                                                    難度 {q.difficulty}
                                                </span>
                                                {q.topicTags.slice(0, 2).map((tag, i) => (
                                                    <span key={i} className="px-2 py-0.5 rounded-full bg-secondary/20 text-xs text-muted-foreground">
                                                        {tag}
                                                    </span>
                                                ))}
                                                <span className="text-xs text-muted-foreground/60 ml-auto">
                                                    信心度 {Math.round(q.confidenceScore * 100)}%
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </button>

                                <AnimatePresence>
                                    {selectedQuestion === idx && (
                                        <motion.div
                                            initial={{ height: 0, opacity: 0 }}
                                            animate={{ height: 'auto', opacity: 1 }}
                                            exit={{ height: 0, opacity: 0 }}
                                            className="border-t border-border/50"
                                        >
                                            <div className="p-4 space-y-3 bg-gray-50/50">
                                                {q.options && (
                                                    <div className="space-y-2">
                                                        {q.options.map((opt, i) => (
                                                            <div
                                                                key={i}
                                                                className={cn(
                                                                    "p-3 rounded-lg border",
                                                                    opt.isCorrect
                                                                        ? "bg-green-50 border-green-200"
                                                                        : "bg-white border-border"
                                                                )}
                                                            >
                                                                <span className="font-medium text-foreground/90">{opt.label}. </span>
                                                                <span className="text-foreground/70">{opt.text}</span>
                                                            </div>
                                                        ))}
                                                    </div>
                                                )}
                                                <div className="p-3 rounded-lg bg-blue-50 border border-blue-100">
                                                    <p className="text-sm font-medium text-blue-700 mb-1">正確答案</p>
                                                    <p className="text-foreground/90">{q.correctAnswer}</p>
                                                </div>
                                                <div className="p-3 rounded-lg bg-purple-50 border border-purple-100">
                                                    <p className="text-sm font-medium text-purple-700 mb-1">詳解</p>
                                                    <p className="text-sm text-foreground/80 leading-relaxed">{q.explanation}</p>
                                                </div>
                                            </div>
                                        </motion.div>
                                    )}
                                </AnimatePresence>
                            </div>
                        ))}
                    </div>
                )}

                {activeTab === 'weakpoints' && (
                    <div className="space-y-3">
                        {weakPoints.map((wp, idx) => (
                            <div key={idx} className="p-4 rounded-xl bg-white border border-border/50 shadow-sm">
                                <h4 className="font-semibold text-foreground mb-2">{wp.concept}</h4>
                                <p className="text-sm text-muted-foreground mb-2">{wp.reason}</p>
                                <div className="p-3 rounded-lg bg-blue-50 border border-blue-100">
                                    <p className="text-xs font-medium text-blue-700 mb-1">練習建議</p>
                                    <p className="text-sm text-foreground/80">{wp.practiceSuggestion}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                )}

                {activeTab === 'roadmap' && (
                    <div className="space-y-4">
                        {roadmap.map((phase, idx) => (
                            <div key={idx} className="p-4 rounded-xl bg-white border border-border/50 shadow-sm">
                                <div className="flex items-center justify-between mb-3">
                                    <h4 className="font-semibold text-foreground">{phase.phase}</h4>
                                    <span className="text-sm text-muted-foreground">{phase.estimatedHours} 小時</span>
                                </div>
                                <div className="flex flex-wrap gap-2">
                                    {phase.topics.map((topic, i) => (
                                        <span
                                            key={i}
                                            className="px-3 py-1 rounded-full bg-green-100 border border-green-200 text-sm text-green-700"
                                        >
                                            {topic}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </motion.div>
    )
}

// ============================================
// Main Progressive Analysis Card
// ============================================

export function ProgressiveAnalysisCard({
    analysisId,
    fileName,
    onAnalysisUpdate
}: {
    analysisId: string
    fileName: string
    onAnalysisUpdate?: (analysis: FileAnalysis) => void
}) {
    const [analysis, setAnalysis] = useState<FileAnalysis | null>(null)
    const [error, setError] = useState<string | null>(null)

    // 格式化分析結果為 Markdown
    const formatAnalysisToMarkdown = (analysis: FileAnalysis): string => {
        let markdown = `# ${fileName}\n\n`

        // Layer 1: Quick Summary
        if (analysis.quickSummary) {
            markdown += `## 📝 快速預覽\n\n${analysis.quickSummary}\n\n`
            if (analysis.detectedSubject) {
                markdown += `**科目**: ${analysis.detectedSubject}\n\n`
            }
            if (analysis.detectedTopics && analysis.detectedTopics.length > 0) {
                markdown += `**主題**: ${analysis.detectedTopics.join('、')}\n\n`
            }
        }

        // Layer 2: Deep Analysis
        if (analysis.coreConcepts && analysis.coreConcepts.length > 0) {
            markdown += `## 🧠 核心概念\n\n`
            analysis.coreConcepts.forEach((concept, idx) => {
                markdown += `### ${idx + 1}. ${concept.name}\n\n`
                markdown += `${concept.explanation}\n\n`
                if (concept.pageRefs.length > 0) {
                    markdown += `*參考頁碼: ${concept.pageRefs.join(', ')}*\n\n`
                }
            })
        }

        if (analysis.keyInsights && analysis.keyInsights.length > 0) {
            markdown += `## 💡 關鍵洞察\n\n`
            analysis.keyInsights.forEach((insight, idx) => {
                markdown += `${idx + 1}. **${insight.insight}**\n`
                markdown += `   ${insight.evidence}\n\n`
            })
        }

        if (analysis.structuredNotes) {
            markdown += `## 📖 結構化筆記\n\n${analysis.structuredNotes}\n\n`
        }

        // Layer 3: Exam Prediction
        if (analysis.examPredictions && analysis.examPredictions.length > 0) {
            markdown += `## 🎯 考題預測\n\n`
            analysis.examPredictions.forEach((q, idx) => {
                markdown += `### 預測題 ${idx + 1}\n\n`
                markdown += `**題目**: ${q.questionText}\n\n`
                markdown += `**難度**: ${q.difficulty}/5 | **信心度**: ${Math.round(q.confidenceScore * 100)}%\n\n`
                if (q.correctAnswer) {
                    markdown += `**答案**: ${q.correctAnswer}\n\n`
                }
                if (q.explanation) {
                    markdown += `**詳解**: ${q.explanation}\n\n`
                }
                markdown += `---\n\n`
            })
        }

        if (analysis.weakPoints && analysis.weakPoints.length > 0) {
            markdown += `## ⚠️ 易錯點\n\n`
            analysis.weakPoints.forEach((wp, idx) => {
                markdown += `### ${idx + 1}. ${wp.concept}\n\n`
                markdown += `**原因**: ${wp.reason}\n\n`
                markdown += `**練習建議**: ${wp.practiceSuggestion}\n\n`
            })
        }

        if (analysis.studyRoadmap && analysis.studyRoadmap.length > 0) {
            markdown += `## 🗺️ 學習路徑\n\n`
            analysis.studyRoadmap.forEach((phase, idx) => {
                markdown += `### ${phase.phase} (${phase.estimatedHours} 小時)\n\n`
                markdown += `**主題**: ${phase.topics.join('、')}\n\n`
            })
        }

        markdown += `---\n\n*由 AI 自動生成於 ${new Date().toLocaleDateString('zh-TW')}*\n`

        return markdown
    }

    useEffect(() => {
        let pollInterval: any
        let pollCount = 0
        const MAX_POLL_ATTEMPTS = 90 // 3 minutes max (90 * 2s = 180s)

        const fetchAnalysis = async () => {
            try {
                pollCount++
                console.log(`[ProgressiveAnalysisCard] 📡 Polling attempt ${pollCount}/${MAX_POLL_ATTEMPTS} for analysisId: ${analysisId}`)

                // Timeout check - stop polling after 3 minutes
                if (pollCount > MAX_POLL_ATTEMPTS) {
                    clearInterval(pollInterval)
                    setError('分析處理時間過長，請稍後重新整理頁面查看結果')
                    console.error('[ProgressiveAnalysisCard] ❌ Max poll attempts reached')
                    return
                }

                const controller = new AbortController()
                const timeoutId = setTimeout(() => controller.abort(), 10000) // 10s timeout per request

                const url = `/api/rag/upload-elite?analysisId=${analysisId}`
                console.log(`[ProgressiveAnalysisCard] 🔗 Fetching: ${url}`)

                const res = await fetch(url, {
                    signal: controller.signal
                })
                clearTimeout(timeoutId)

                console.log(`[ProgressiveAnalysisCard] 📥 Response status: ${res.status}`)

                if (!res.ok) {
                    const errorText = await res.text()
                    console.error('[ProgressiveAnalysisCard] ❌ Response not OK:', errorText)
                    throw new Error('Failed to fetch analysis')
                }

                const data = await res.json()
                console.log('[ProgressiveAnalysisCard] 📊 Received data:', {
                    status: data.analysis?.status,
                    hasQuickSummary: !!data.analysis?.quick_summary,
                    hasConcepts: !!data.analysis?.core_concepts,
                    hasPredictions: !!data.analysis?.exam_predictions,
                    processingTime: data.analysis?.processing_time_ms
                })

                setAnalysis(data.analysis)
                onAnalysisUpdate?.(data.analysis)

                // Stop polling when complete or failed
                if (data.analysis.status === 'prediction_ready' || data.analysis.status === 'failed') {
                    clearInterval(pollInterval)
                    console.log(`[ProgressiveAnalysisCard] ✅ Polling complete. Final status: ${data.analysis.status}`)
                }
            } catch (err) {
                if (err instanceof Error && err.name === 'AbortError') {
                    console.warn('[ProgressiveAnalysisCard] ⏱️ Request timeout, will retry...')
                    // Don't stop polling on timeout, just skip this iteration
                } else {
                    console.error('[ProgressiveAnalysisCard] ❌ Fetch error:', err)
                    setError(err instanceof Error ? err.message : '載入失敗')
                    clearInterval(pollInterval)
                }
            }
        }

        // Initial fetch
        fetchAnalysis()

        // Poll every 2 seconds
        pollInterval = setInterval(fetchAnalysis, 2000)

        return () => clearInterval(pollInterval)
    }, [analysisId, onAnalysisUpdate])

    if (error) {
        return (
            <div className="p-6 rounded-2xl border border-red-500/20 bg-red-50">
                <p className="text-red-600">❌ {error}</p>
            </div>
        )
    }

    if (!analysis) {
        return (
            <div className="space-y-6">
                {/* File Info Skeleton */}
                <div className="flex items-center gap-3 px-4 py-3 rounded-2xl border border-border bg-card">
                    <Loader2 className="w-5 h-5 animate-spin text-muted-foreground" />
                    <div className="flex-1">
                        <p className="text-sm font-medium text-foreground">{fileName}</p>
                        <p className="text-xs text-muted-foreground">正在載入分析結果...</p>
                    </div>
                </div>

                {/* Progress Skeleton */}
                <div className="space-y-4">
                    <div className="h-24 rounded-2xl border border-border bg-card/50 animate-pulse" />
                    <div className="h-48 rounded-2xl border border-border bg-card/50 animate-pulse" />
                    <div className="h-64 rounded-2xl border border-border bg-card/50 animate-pulse" />
                </div>
            </div>
        )
    }

    const stages: AnalysisStage[] = [
        {
            id: 'preview',
            name: '快速預覽',
            icon: <Sparkles className="w-5 h-5" />,
            targetTime: '3s',
            status: analysis.status === 'processing' ? 'current' :
                analysis.status === 'failed' ? 'failed' : 'done'
        },
        {
            id: 'analysis',
            name: '深度分析',
            icon: <Brain className="w-5 h-5" />,
            targetTime: '15s',
            status: analysis.status === 'processing' || analysis.status === 'preview_ready' ?
                (analysis.status === 'preview_ready' ? 'current' : 'pending') :
                analysis.status === 'failed' ? 'failed' : 'done'
        },
        {
            id: 'prediction',
            name: '考題預測',
            icon: <Target className="w-5 h-5" />,
            targetTime: '30s',
            status: analysis.status === 'prediction_ready' ? 'done' :
                analysis.status === 'analysis_ready' ? 'current' :
                    analysis.status === 'failed' ? 'failed' : 'pending'
        }
    ]

    return (
        <div className="space-y-6">
            {/* File Info */}
            <div className="flex items-center gap-3 px-4 py-3 rounded-2xl border border-border bg-card">
                <FileText className="w-5 h-5 text-blue-500" />
                <div className="flex-1">
                    <p className="text-sm font-medium text-foreground">{fileName}</p>
                    <p className="text-xs text-muted-foreground">
                        處理時間: {analysis.processingTimeMs ? `${(analysis.processingTimeMs / 1000).toFixed(1)} s` : '計算中...'}
                    </p>
                </div>
            </div>

            {/* Progress Indicator */}
            <ProgressIndicator stages={stages} />

            {/* Simplified Markdown Display - All Layers */}
            {analysis.structuredNotes && (
                <div className="p-6 rounded-2xl border border-border bg-card">
                    <div className="prose prose-sm max-w-none dark:prose-invert">
                        <ReactMarkdown
                            remarkPlugins={[remarkGfm]}
                            components={{
                                h1: ({ node, ...props }) => <h1 className="text-2xl font-bold mb-4 text-foreground" {...props} />,
                                h2: ({ node, ...props }) => <h2 className="text-xl font-semibold mt-6 mb-3 text-foreground" {...props} />,
                                h3: ({ node, ...props }) => <h3 className="text-lg font-medium mt-4 mb-2 text-foreground" {...props} />,
                                p: ({ node, ...props }) => <p className="mb-3 text-foreground/90 leading-relaxed" {...props} />,
                                ul: ({ node, ...props }) => <ul className="list-disc pl-6 mb-3 space-y-1" {...props} />,
                                ol: ({ node, ...props }) => <ol className="list-decimal pl-6 mb-3 space-y-1" {...props} />,
                                li: ({ node, ...props }) => <li className="text-foreground/90" {...props} />,
                                strong: ({ node, ...props }) => <strong className="font-semibold text-foreground" {...props} />,
                                code: ({ node, inline, ...props }: any) =>
                                    inline ? (
                                        <code className="px-1.5 py-0.5 rounded bg-muted text-sm font-mono" {...props} />
                                    ) : (
                                        <code className="block p-3 rounded bg-muted text-sm font-mono overflow-x-auto" {...props} />
                                    ),
                                blockquote: ({ node, ...props }) => (
                                    <blockquote className="border-l-4 border-primary pl-4 italic text-muted-foreground my-4" {...props} />
                                ),
                            }}
                        >
                            {analysis.structuredNotes}
                        </ReactMarkdown>
                    </div>
                </div>
            )}

            {/* Quick Summary Fallback - if no structured notes yet */}
            {!analysis.structuredNotes && analysis.quickSummary && (
                <div className="p-6 rounded-2xl border border-border bg-card">
                    <h3 className="text-lg font-semibold mb-3 flex items-center gap-2">
                        <Sparkles className="w-5 h-5 text-yellow-500" />
                        快速預覽
                    </h3>
                    <p className="text-foreground/90 leading-relaxed">{analysis.quickSummary}</p>
                    {analysis.detectedTopics && analysis.detectedTopics.length > 0 && (
                        <div className="mt-4 flex flex-wrap gap-2">
                            {analysis.detectedTopics.map((topic, idx) => (
                                <span
                                    key={idx}
                                    className="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm"
                                >
                                    {topic}
                                </span>
                            ))}
                        </div>
                    )}
                </div>
            )}

            {/* Exam Questions - Simple List */}
            {analysis.examPredictions && analysis.examPredictions.length > 0 && (
                <div className="p-6 rounded-2xl border border-border bg-card">
                    <h3 className="text-lg font-semibold mb-4 flex items-center gap-2">
                        <Target className="w-5 h-5 text-blue-500" />
                        考題預測 ({analysis.examPredictions.length} 題)
                    </h3>
                    <div className="space-y-4">
                        {analysis.examPredictions.slice(0, 5).map((q, idx) => (
                            <div key={idx} className="border-l-4 border-primary pl-4">
                                <p className="font-medium text-foreground mb-2">
                                    {idx + 1}. {q.questionText}
                                </p>
                                {q.options && q.options.length > 0 && (
                                    <div className="space-y-1 mb-2 text-sm">
                                        {q.options.map((opt, optIdx) => (
                                            <div
                                                key={optIdx}
                                                className={opt.isCorrect ? 'text-green-600 font-medium' : 'text-muted-foreground'}
                                            >
                                                {opt.label}. {opt.text}
                                                {opt.isCorrect && ' ✓'}
                                            </div>
                                        ))}
                                    </div>
                                )}
                                <p className="text-sm text-muted-foreground">
                                    💡 {q.explanation}
                                </p>
                            </div>
                        ))}
                        {analysis.examPredictions.length > 5 && (
                            <p className="text-sm text-muted-foreground text-center">
                                還有 {analysis.examPredictions.length - 5} 題，請存到筆記本查看完整內容
                            </p>
                        )}
                    </div>
                </div>
            )}

            {/* Error State */}
            {analysis.status === 'failed' && (
                <div className="p-6 rounded-2xl border border-red-500/20 bg-red-50">
                    <p className="text-red-600">❌ 分析失敗: {analysis.errorMessage || '未知錯誤'}</p>
                </div>
            )}

            {/* Save to Notebook Button - 只在分析完成時顯示 */}
            {(analysis.status === 'prediction_ready' || analysis.status === 'analysis_ready') && (
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="pt-6 border-t border-border"
                >
                    <div className="flex justify-center">
                        <NotebookSaveButton
                            title={`${fileName} - 重點統整`}
                            content={formatAnalysisToMarkdown(analysis)}
                            sourceType="summary"
                            documentId={analysisId}
                            tags={[
                                '學測',
                                '重點統整',
                                ...(analysis.detectedTopics || []).slice(0, 3)
                            ]}
                            onSaveSuccess={() => {
                                console.log('[ProgressiveAnalysisCard] Successfully saved to notebook')
                            }}
                        />
                    </div>
                </motion.div>
            )}
        </div>
    )
}
